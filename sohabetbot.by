# ---------------------------------------------------------------------------
# NİYET TESPİTİ
# ---------------------------------------------------------------------------
def niyet_bul(metin):
    low = normalize(metin)

    if eslesen(low, [
        "selam", "merhaba", "selamlar", "hey", "hello", "sa", "s a",
        "s.a", "slm", "selamın aleyküm", "selamin aleykum"
    ]):
        return "selamlama"

    if eslesen(low, [
        "nasılsın", "nasilsin", "iyi misin", "iyisin", "iyisin dimi",
        "keyifler nasıl", "keyifler nasil", "nasıl gidiyor",
        "nasil gidiyor", "hayat nasıl", "hayat nasil", "naber",
        "ne haber", "ne var ne yok"
    ]):
        return "nasilsin"

    if eslesen(low, [
        "ne yapıyorsun", "ne yapiyorsun", "napıyorsun", "napiyorsun",
        "napıyon", "napiyon", "napiyosun", "napıyon", "noluyo",
        "ne oluyor", "neler oluyor", "ne var"
    ]):
        return "gunluk"

    if eslesen(low, [
        "teşekkür", "tesekkur", "sağ ol", "sag ol", "eyvallah",
        "eyw", "eyvallah", "adamsın", "adamsin"
    ]):
        return "tesekkur"

    if eslesen(low, [
        "şaka", "saka", "espri", "güldür", "guldur", "komik",
        "beni güldür", "beni guldur"
    ]):
        return "espri"

    if eslesen(low, [
        "görüşürüz", "gorusuruz", "kaçtım", "kactim", "gidiyorum",
        "sonra konuşuruz", "sonra gorusuruz", "bay bay",
        "iyi geceler", "iyi akşamlar", "iyi aksamlar", "hoşça kal",
        "hosca kal"
    ]):
        return "veda"

    if eslesen(low, [
        "cidden mi", "yok artık", "yok artik", "hadi ya", "şaka yapıyorsun",
        "saka yapiyorsun", "harbi mi", "gerçekten mi", "gercekten mi",
        "vay be", "oha"
    ]):
        return "tepki"

    if eslesen(low, [
        "aynen", "doğru", "dogru", "katılıyorum", "katiliyorum",
        "haklısın", "haklisin", "evet aynen"
    ]):
        return "onay"

    if eslesen(low, [
        "yok", "hayır", "hayir", "sanmıyorum", "sanmiyorum",
        "katılmıyorum", "katilmiyorum", "bence değil", "bence degil"
    ]):
        return "red"

    if eslesen(low, [
        "sence", "ne düşünüyorsun", "ne dusunuyorsun", "biliyor musun",
        "bana anlat", "fikrin ne", "ne dersin", "sen olsan ne yapardın",
        "sen olsan ne yapardin"
    ]):
        return "merak"

    if eslesen(low, [
        "canım sıkkın", "canim sikkin", "moralim bozuk",
        "üzgünüm", "uzgunum", "kötüyüm", "kotuyum",
        "keyfim yok", "modum düşük", "modum dusuk"
    ]):
        return "destek"

    if eslesen(low, [
        "sinirliyim", "sinir oldum", "delirdim", "çok kızgınım",
        "cok kizginim", "tepem attı", "tepem atti"
    ]):
        return "sakin"

    if eslesen(low, [
        "çok mutluyum", "cok mutluyum", "mutluyum", "keyfim yerinde",
        "harikayım", "harikayim"
    ]):
        return "mutlu"

    if eslesen(low, [
        "kimsin", "sen kimsin", "adın ne", "adin ne",
        "ismin ne", "sen nesin"
    ]):
        return "kimlik"

    if eslesen(low, [
        "fal bak", "falına bak", "falina bak", "kahve falı",
        "kahve fali"
    ]):
        return "fal"

    if eslesen(low, [
        "sorgu yap", "sorgulama", "sorgu", "sorgula"
    ]):
        return "sorgu"

    if eslesen(low, [
        "sanal no", "sanal numara", "sms", "sms numarası",
        "sms numarasi"
    ]):
        return "sanal_no"

    if eslesen(low, [
        "bakiye", "param ne kadar", "hesapta ne var"
    ]):
        return "bakiye"

    return "genel"


# ---------------------------------------------------------------------------
# BAĞLAMA GÖRE CEVAP
# ---------------------------------------------------------------------------
def gecmis_referansi(user_id):
    gecmis = son_konusma(user_id)
    kullanici_mesajlari = [
        x["metin"] for x in gecmis
        if x["rol"] == "user"
    ]
    if len(kullanici_mesajlari) >= 2:
        return kullanici_mesajlari[-2]
    return ""


def sohbet_yanit(user_id, metin):
    m = temiz_metin(metin)
    low = normalize(m)

    if kufur_var_mi(m):
        return kufur_yanit(user_id)

    niyet = niyet_bul(m)
    stil = duygu_ve_stil(m)
    onceki = gecmis_referansi(user_id)

    # Özellik geçişleri.
    if niyet == "fal":
        return "🔮 Fal moduna geçebiliriz. Ne tür fal istiyorsun?"

    if niyet == "sorgu":
        return "🔍 Sorgulama tarafına geçebiliriz. Ne yapmak istediğini yaz, uygun menüye yönlendireyim."

    if niyet == "sanal_no":
        return "📱 Sanal numara tarafına geçiyoruz. İstersen menüden 📱 Sanal No'ya dokun."

    if niyet == "bakiye":
        return "💰 Bakiye kontrolü için menüden 💰 Bakiye'ye basabilirsin."

    if niyet == "kimlik":
        return cevap_sec(user_id, [
            "🤖 Ben Savitar. Sohbet ederim, konuyu takip ederim ve menüdeki özelliklere yönlendiririm.",
            "😎 Ben Savitar. Biraz sohbet, biraz mizah, gerektiğinde de menü desteği için buradayım.",
            "🤖 Savitar benim. Muhabbet tarafında daha doğal konuşmaya çalışıyorum; konu sende."
        ])

    if niyet == "selamlama":
        return cevap_sec(user_id, SELAMLAMA)

    if niyet == "nasilsin":
        return cevap_sec(user_id, NASILSIN)

    if niyet == "gunluk":
        return cevap_sec(user_id, GUNLUK_MUHABBET)

    if niyet == "tesekkur":
        return cevap_sec(user_id, TESEKKUR)

    if niyet == "espri":
        return cevap_sec(user_id, ESPRI)

    if niyet == "veda":
        return cevap_sec(user_id, VEDA)

    if niyet == "tepki":
        return cevap_sec(user_id, TEPKI)

    if niyet == "onay":
        return cevap_sec(user_id, ONAY)

    if niyet == "red":
        return cevap_sec(user_id, RED)

    if niyet == "merak":
        return cevap_sec(user_id, MERAK)

    if niyet == "destek":
        return cevap_sec(user_id, DESTEK)

    if niyet == "sakin":
        return cevap_sec(user_id, Sakin)

    if niyet == "mutlu":
        return cevap_sec(user_id, MUTLU)

    # Soru cümlesi: tek bir "güzel soru" cevabına düşmesin.
    if (
        low.endswith("?")
        or any(x in low.split() for x in (
            "neden", "nasıl", "nasil", "ne", "ne zaman",
            "nerede", "kim", "hangisi", "niye"
        ))
    ):
        havuz = [
            "🤔 Bunun net cevabı konuya bağlı. Biraz daha detay verirsen beraber açalım.",
            "👀 Güzel, burada detay önemli. Tam olarak neyi merak ediyorsun?",
            "😎 Konuyu biraz aç; sana doğrudan üzerinden konuşabileceğimiz bir cevap vereyim.",
            "🧠 Bunu birkaç açıdan değerlendirebiliriz. Sen önce olayı anlat.",
            "🤝 Soruyu aldım. Bağlamı verirsen daha isabetli cevaplayabilirim."
        ]
        return cevap_sec(user_id, havuz)

    # "peki / devam / şimdi ne" gibi kısa devam mesajlarında geçmişe referans.
    if eslesen(low, [
        "devam", "sonra", "peki", "ee", "e şimdi", "e simdi",
        "şimdi ne", "simdi ne", "sonra ne oldu", "anlat"
    ]):
        if onceki:
            return cevap_sec(user_id, [
                f"😎 Devam ediyoruz. Az önce “{onceki[:100]}” demiştin; oradan yürüyebiliriz.",
                f"👀 Tamam, o konuyu bırakmıyorum. “{onceki[:100]}” kısmından devam edelim.",
                "🤝 Tamam, kaldığımız yerden. Bir sonraki detayı anlat.",
                "😄 Devam. Bu sefer hikâyenin sonraki kısmını merak ettim."
            ])
        return cevap_sec(user_id, GENEL)

    # Duygu/stil, niyet yoksa da konuşmayı canlı tutar.
    if stil == "destekleyici":
        return cevap_sec(user_id, DESTEK)

    if stil == "sakin":
        return cevap_sec(user_id, Sakin)

    if stil == "neşeli":
        return cevap_sec(user_id, MUTLU)

    if stil == "esprili":
        return cevap_sec(user_id, ESPRI + TEPKI)

    if stil == "samimi":
        return cevap_sec(user_id, [
            "😎 Aynen kanka, anlat bakalım.",
            "🤝 Tamam dostum, seni dinliyorum.",
            "😂 Heh, şimdi muhabbet başladı. Devam et.",
            "👀 Söyle aga, ne dönüyor?",
            "😄 Tamam reis, konu sende."
        ])

    return cevap_sec(user_id, GENEL)


# ---------------------------------------------------------------------------
# MESAJ İŞLEME
# ---------------------------------------------------------------------------
def mesaj_isle(message):
    if not message.text:
        return

    user_id = message.from_user.id
    metin = temiz_metin(message.text)

    hafizaya_ekle(user_id, "user", metin)

    cevap = sohbet_yanit(user_id, metin)

    hafizaya_ekle(user_id, "bot", cevap)

    bot.reply_to(message, cevap)


# ---------------------------------------------------------------------------
# KOMUTLAR
# ---------------------------------------------------------------------------
@bot.message_handler(commands=["start"])
def start(message):
    SOHBET_HAFIZASI[message.from_user.id].clear()
    SON_CEVAPLAR[message.from_user.id].clear()
    KUFUR_UYARILARI[message.from_user.id] = 0

    text = """🤖 Bot aktif!

Daha doğal sohbet sistemi hazır:
💬 Bağlamlı muhabbet
🧠 Kısa süreli konuşma hafızası
🔄 Tekrarlı cevap azaltma
😂 Mizah ve tepki çeşitliliği
❤️ Duyguya göre cevap
🎭 Konuşma tarzına uyum
🤬 Küfür/argo karşılığı
🔮 Fal / 🔍 Sorgulama geçişleri

Aşağıdaki menüden bir özellik seçebilirsin."""

    bot.send_message(
        message.chat.id,
        text,
        reply_markup=ana_menu()
    )


@bot.message_handler(commands=["id"])
def user_id(message):
    bot.reply_to(
        message,
        f"🆔 Telegram ID: {message.from_user.id}"
    )


@bot.message_handler(commands=["help"])
def help_command(message):
    text = """❓ Yardım

💬 Sohbet — Doğal sohbet, bağlam hafızası, çeşitli cevaplar ve duygu uyumu.
📱 Sanal No — SMS Virtual hesabı için durum menüsü.
💰 Bakiye — SMS Virtual hesap bakiyesini kontrol eder.
👤 Telegram ID — Telegram kullanıcı ID'nizi gösterir.

Komutlar: /start /id /help

Not: Küfür/argo tespitinde bot küfür etmeden, üsluba uygun şekilde karşılık verir."""

    bot.send_message(
        message.chat.id,
        text,
        reply_markup=ana_menu()
    )


# ---------------------------------------------------------------------------
# MENÜ
# ---------------------------------------------------------------------------
@bot.message_handler(func=lambda message: message.text == "👤 Telegram ID")
def menu_id(message):
    user_id(message)


@bot.message_handler(func=lambda message: message.text == "❓ Yardım")
def menu_help(message):
    help_command(message)


@bot.message_handler(func=lambda message: message.text == "💰 Bakiye")
def balance(message):
    data, error = smsvirtual_profile()

    if error:
        bot.reply_to(
            message,
            f"⚠️ Bakiye alınamadı: {error}"
        )
        return

    if isinstance(data, dict):
        profile = data.get("data", data)
        if not isinstance(profile, dict):
            profile = data.get("profile", data)
    else:
        profile = {}

    value = (
        profile.get("balance", "bilinmiyor")
        if isinstance(profile, dict)
        else "bilinmiyor"
    )

    bot.reply_to(
        message,
        f"💰 SMS Virtual bakiye: {value}"
    )


@bot.message_handler(func=lambda message: message.text == "📱 Sanal No")
def virtual_number(message):
    text = """📱 Sanal Numara

Bu menü şu anda yalnızca hesap durumunu kontrol eder.
Numara satın alma veya doğrulama işlemi otomatikleştirilmemiştir."""

    bot.send_message(
        message.chat.id,
        text
    )


@bot.message_handler(func=lambda message: message.text == "💬 Sohbet")
def chat_mode(message):
    bot.reply_to(
        message,
        "💬 Sohbet moduna geçtik. Ne konuşmak istersen yaz; yakın konuşmaları dikkate alıp aynı cevabı tekrar etmemeye çalışacağım."
    )


# ---------------------------------------------------------------------------
# GENEL MESAJ
# ---------------------------------------------------------------------------
@bot.message_handler(func=lambda message: True)
def text_handler(message):
    mesaj_isle(message)


# ---------------------------------------------------------------------------
# TELEGRAM BAĞLANTISI / POLLING
# ---------------------------------------------------------------------------
try:
    print("[BOOT 4] TeleBot olusturuldu", flush=True)

    me = bot.get_me()

    print(
        f"[BOOT 5] Telegram baglantisi OK: @{me.username}",
        flush=True
    )

    try:
        bot.delete_webhook(drop_pending_updates=False)

        print(
            "[BOOT 6] Webhook temizlendi",
            flush=True
        )

    except Exception as exc:
        print(
            f"[BOOT 6] Webhook temizleme uyarisi: {type(exc).__name__}: {exc}",
            flush=True
        )

    print(
        "[BOOT 7] Yeni sohbet sistemi hazir",
        flush=True
    )

    print(
        "[BOOT 8] Polling baslatiliyor...",
        flush=True
    )

    # Railway üzerinde tek polling sahibi olacak şekilde çalışır.
    bot.infinity_polling(
        skip_pending=False,
        timeout=30,
        long_polling_timeout=30,
        allowed_updates=["message", "callback_query"]
    )

except Exception as exc:
    print(
        f"[BOOT] UYGULAMA HATASI: {type(exc).__name__}: {exc}",
        flush=True
    )

    traceback.print_exc()
    sys.exit(1)