import os
import sys
import time
import hashlib
import traceback
from collections import defaultdict, deque

VERSION = "SAVITAR-FRESH-2026-10-05"
print(f"[FRESH 1] {VERSION} basladi", flush=True)

RAW_TOKEN = os.getenv("BOT_TOKEN", "")
if not RAW_TOKEN:
    raise RuntimeError("BOT_TOKEN Railway Variables içinde tanımlı değil.")

TOKEN = RAW_TOKEN.strip()
if TOKEN.lower().startswith("bot_token="):
    TOKEN = TOKEN.split("=", 1)[1].strip()
TOKEN = TOKEN.strip('"').strip("'").strip()

if any(ch.isspace() for ch in TOKEN) or TOKEN.count(":") != 1:
    raise RuntimeError("BOT_TOKEN biçimi geçersiz.")

fingerprint = hashlib.sha256(TOKEN.encode()).hexdigest()[:12]
prefix = TOKEN.split(":", 1)[0]

print(
    f"[FRESH 2] token format=ok length={len(TOKEN)} prefix={prefix} fingerprint={fingerprint}",
    flush=True,
)

try:
    import telebot
    from telebot import types
    print("[FRESH 3] telebot import OK", flush=True)
except Exception as exc:
    print(f"[FRESH 3] telebot import ERROR: {exc}", flush=True)
    traceback.print_exc()
    sys.exit(1)

bot = telebot.TeleBot(TOKEN)
memory = defaultdict(lambda: deque(maxlen=10))

MENU = types.ReplyKeyboardMarkup(row_width=2, resize_keyboard=True)
MENU.add(
    types.KeyboardButton("💬 Sohbet"),
    types.KeyboardButton("👤 Telegram ID"),
    types.KeyboardButton("❓ Yardım"),
)

def reply(message, text):
    memory[message.from_user.id].append(("bot", text))
    bot.reply_to(message, text)

@bot.message_handler(commands=["start"])
def start(message):
    memory[message.from_user.id].clear()
    text = (
        "🤖 Savitar aktif!\n\n"
        "💬 Sohbet için mesaj yaz.\n"
        "👤 Telegram ID için /id\n"
        "❓ Yardım için /help"
    )
    bot.send_message(message.chat.id, text, reply_markup=MENU)

@bot.message_handler(commands=["id"])
def user_id(message):
    reply(message, f"🆔 Telegram ID: {message.from_user.id}")

@bot.message_handler(commands=["help"])
def help_command(message):
    reply(
        message,
        "❓ Yardım\n\n"
        "💬 Sohbet — Mesajlarını cevaplarım.\n"
        "👤 Telegram ID — Kullanıcı ID'nizi gösterir.\n"
        "🔄 /start — Botu yeniden başlatır."
    )

@bot.message_handler(func=lambda m: m.text == "👤 Telegram ID")
def menu_id(message):
    user_id(message)

@bot.message_handler(func=lambda m: m.text == "❓ Yardım")
def menu_help(message):
    help_command(message)

@bot.message_handler(func=lambda m: m.text == "💬 Sohbet")
def chat(message):
    reply(message, "💬 Sohbet modu açık dostum. Ne konuşalım?")

@bot.message_handler(func=lambda m: True)
def chat_handler(message):
    if not message.text:
        return
    user_id_value = message.from_user.id
    memory[user_id_value].append(("user", message.text[:500]))
    text = message.text.strip()
    low = text.lower()

    if any(x in low for x in ["selam", "merhaba", "hey", "sa"]):
        answer = "👋 Selam dostum! Buradayım. Nasılsın?"
    elif any(x in low for x in ["nasılsın", "nasilsin", "naber", "ne haber"]):
        answer = "😎 İyiyim dostum. Senin keyifler nasıl?"
    elif any(x in low for x in ["teşekkür", "tesekkur", "sağ ol", "sag ol", "eyvallah"]):
        answer = "🤝 Rica ederim dostum."
    elif any(x in low for x in ["görüşürüz", "gorusuruz", "bay bay", "iyi geceler"]):
        answer = "👋 Görüşürüz dostum. Yine gel."
    elif "?" in text:
        answer = "🤔 Güzel soru. Biraz daha detay verirsen beraber bakalım."
    else:
        answer = "👀 Anladım dostum. Biraz daha anlat, seni dinliyorum."

    reply(message, answer)

try:
    print("[FRESH 4] Telegram kimlik doğrulaması basliyor", flush=True)
    me = bot.get_me()
    print(f"[FRESH 5] TELEGRAM OK: @{me.username} id={me.id}", flush=True)

    bot.delete_webhook(drop_pending_updates=False)
    print("[FRESH 6] webhook temizlendi", flush=True)

    print("[FRESH 7] POLLING BASLIYOR", flush=True)
    bot.infinity_polling(
        skip_pending=False,
        timeout=30,
        long_polling_timeout=30,
        allowed_updates=["message"],
    )
except Exception as exc:
    print(f"[FRESH ERROR] {type(exc).__name__}: {exc}", flush=True)
    traceback.print_exc()
    sys.exit(1)
