# ---------------------------------------------------------------------------
# SOHBET HAFIZASI
# ---------------------------------------------------------------------------
# Her kullanıcı için son 12 konuşma turunu tutar.
# Railway yeniden başlatılırsa RAM belleği sıfırlanır.
SOHBET_HAFIZASI = defaultdict(lambda: deque(maxlen=12))
KUFUR_UYARILARI = defaultdict(int)
SON_CEVAPLAR = defaultdict(lambda: deque(maxlen=8))

# ---------------------------------------------------------------------------
# KUFUR / HAKARET TESPITI
# Bot kendi cevabında küfür kullanmaz.
# ---------------------------------------------------------------------------
KUFUR_KELIMELERI = {
    "amk", "aq", "a.q", "mk", "m.k", "siktir", "sikeyim", "sikik",
    "sik", "orospu", "oç", "oc", "piç", "pezevenk", "yarrak", "yarak",
    "salak", "gerizekali", "gerizekalı", "aptal", "mal", "eşşek", "esek",
    "ananı", "anani", "anan", "göt", "got", "ibne", "kahpe", "dangalak",
    "şerefsiz", "serefsiz", "haysiyetsiz", "puşt", "pust", "bok",
    "boktan", "sikikçe", "siktirgit", "siktir git"
}

# ---------------------------------------------------------------------------
# ANA MENÜ
# ---------------------------------------------------------------------------
def ana_menu():
    markup = types.ReplyKeyboardMarkup(row_width=2, resize_keyboard=True)
    markup.add(
        types.KeyboardButton("📱 Sanal No"),
        types.KeyboardButton("💰 Bakiye"),
        types.KeyboardButton("💬 Sohbet"),
        types.KeyboardButton("👤 Telegram ID"),
        types.KeyboardButton("❓ Yardım"),
    )
    return markup


# ---------------------------------------------------------------------------
# SMS VIRTUAL
# ---------------------------------------------------------------------------
def smsvirtual_profile():
    api_key = os.getenv("SMSV_API_KEY")
    if not api_key:
        return None, "SMSV_API_KEY tanımlı değil."

    req = Request(
        "https://api.smsvirtual.io/v1/profile/",
        headers={
            "x-api-key": api_key,
            "Accept": "application/json"
        },
        method="GET",
    )

    try:
        with urlopen(req, timeout=10) as response:
            return json.loads(response.read().decode("utf-8")), None
    except HTTPError as exc:
        return None, f"API HTTP hatası: {exc.code}"
    except (URLError, TimeoutError) as exc:
        return None, f"API bağlantı hatası: {type(exc).__name__}"
    except Exception as exc:
        return None, f"API hatası: {type(exc).__name__}"


# ---------------------------------------------------------------------------
# METİN YARDIMCILARI
# ---------------------------------------------------------------------------
def temiz_metin(metin):
    return re.sub(r"\s+", " ", (metin or "").strip())


def normalize(metin):
    m = temiz_metin(metin).lower()
    # Noktalama ve günlük yazım farklılıklarını biraz daha rahat yakala.
    m = m.replace("’", "'").replace("ı", "i")
    m = re.sub(r"[^\w\s']", " ", m, flags=re.UNICODE)
    m = re.sub(r"\s+", " ", m).strip()
    return m


def kelimeler(metin):
    return re.findall(r"[a-zçğıöşü0-9']+", (metin or "").lower())


def kufur_var_mi(metin):
    low = normalize(metin)
    return any(k in low.split() for k in KUFUR_KELIMELERI)


def son_konusma(user_id):
    return list(SOHBET_HAFIZASI[user_id])


def hafizaya_ekle(user_id, rol, metin):
    SOHBET_HAFIZASI[user_id].append({
        "rol": rol,
        "metin": temiz_metin(metin)[:600]
    })


def cevap_sec(user_id, havuz):
    """
    Son kullanılan cevapları mümkün olduğunca tekrar etmez.
    Havuz çok küçükse yine güvenli şekilde seçim yapar.
    """
    if not havuz:
        return "Buradayım dostum. Konuyu biraz aç, beraber devam edelim."

    son = set(SON_CEVAPLAR[user_id])
    uygun = [x for x in havuz if x not in son]

    secilen = random.choice(uygun or havuz)
    SON_CEVAPLAR[user_id].append(secilen)
    return secilen


def eslesen(metin, ifadeler):
    low = normalize(metin)
    return any(normalize(x) in low for x in ifadeler)


# ---------------------------------------------------------------------------
# DUYGU / KONU / KONUŞMA TARZI
# ---------------------------------------------------------------------------
def duygu_ve_stil(metin):
    low = normalize(metin)
    raw = metin or ""

    heyecan = (
        "!" in raw
        or "haha" in low
        or "ahah" in low
        or "lol" in low
        or "😂" in raw
        or "🤣" in raw
    )

    uzgun = eslesen(low, [
        "üzgünüm", "uzgunum", "moralim bozuk", "canım sıkkın",
        "canim sikkin", "kötüyüm", "kotuyum", "berbatım",
        "berbatim", "keyfim yok", "modum düşük", "modum dusuk",
        "içim sıkılıyor", "icim sikiliyor"
    ])

    kizgin = eslesen(low, [
        "sinirliyim", "sinir oldum", "delirdim", "çok kızgınım",
        "cok kizginim", "tepem attı", "tepem atti", "çok sinirlendim"
    ])

    mutlu = eslesen(low, [
        "çok mutluyum", "cok mutluyum", "mutluyum", "keyfim yerinde",
        "çok iyiyim", "cok iyiyim", "harikayım", "harikayim",
        "bugün çok iyi", "bugun cok iyi"
    ])

    saka = eslesen(low, [
        "şaka", "saka", "haha", "ahah", "lol", "espri", "güldür",
        "guldur", "komik"
    ])

    samimi = eslesen(low, [
        "kanka", "dostum", "bro", "aga", "abi", "reis", "hocam",
        "moruk", "kardeşim", "kardesim"
    ])

    if uzgun:
        return "destekleyici"
    if kizgin:
        return "sakin"
    if mutlu:
        return "neşeli"
    if saka or heyecan:
        return "esprili"
    if samimi:
        return "samimi"
    return "normal"


# ---------------------------------------------------------------------------
# KUFUR CEVAPLARI
# ---------------------------------------------------------------------------
def kufur_yanit(user_id):
    KUFUR_UYARILARI[user_id] += 1
    seviye = KUFUR_UYARILARI[user_id]

    if seviye >= 5:
        havuz = [
            "🛑 Tamam dostum, sertliği biraz azaltalım. Takılacaksan takıl ama muhabbeti seviyeyi düşürmeden sürdürelim.",
            "😏 Üslubu toparlayalım. Ben buradayım; düzgün konuşursan muhabbet de daha iyi akar.",
            "🙂 Sinirini anlıyorum ama küfürü azaltalım. Ne olduysa anlat, konuya bakalım."
        ]
    elif seviye >= 3:
        havuz = [
            "😏 Bu tonla soru sorunca cevaptan çok üslubun dikkat çekiyor. Bir daha dene.",
            "🧊 Sakin ol şampiyon, klavyeye bu kadar yüklenmene gerek yok. Ne konuşuyorduk?",
            "Bana ne mi? Önce üslubunu toparla, sonra konuşuruz. 😏",
            "😂 Gazı biraz keselim dostum. Lafı sertleştirmek yerine derdini anlat, oradan yürüyelim."
        ]
    else:
        havuz = [
            "😏 Ooo, dil biraz vites yükseltti. Sakin ol reis, bana sökmez.",
            "😂 Küfür kontenjanını doldurma. Düzgün konuş da muhabbet akıp gitsin.",
            "😎 Klavyenin gazını biraz keselim. Lafı bana değil konuya çak.",
            "🙃 Sert girdin ama ben kavga moduna geçmem. Bir daha dene, bu kez düzgün muhabbet edelim.",
            "😏 Küfürü bir kenara bırakalım. Söyle bakalım, asıl mesele ne?"
        ]

    return cevap_sec(user_id, havuz)


